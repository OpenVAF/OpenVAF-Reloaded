param "$mfactor"
units = "", desc = "Multiplier (Verilog-A $mfactor)", flags = ParameterFlags(PARA_KIND_INST)

5 terminals
node "sel" units = "V", runits = "A"
node "sum" units = "V", runits = "A"
node "rout" units = "V", runits = "A"
node "mout" units = "V", runits = "A"
node "nconv" units = "V", runits = "A"
node(flow) "flow(sum)" units = "A", runits = "V"
node(flow) "flow(rout)" units = "A", runits = "V"
node(flow) "flow(mout)" units = "A", runits = "V"
node(flow) "flow(nconv)" units = "A", runits = "V"
jacobian (sum, flow(sum)) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (rout, flow(rout)) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (mout, flow(mout)) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (nconv, flow(nconv)) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (flow(sum), sum) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (flow(rout), rout) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (flow(mout), mout) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (flow(nconv), nconv) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
0 states
has bound_step false
