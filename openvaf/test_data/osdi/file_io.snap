param "$mfactor"
units = "", desc = "Multiplier (Verilog-A $mfactor)", flags = ParameterFlags(PARA_KIND_INST)

2 terminals
node "in" units = "V", runits = "A"
node "pos" units = "V", runits = "A"
node(flow) "flow(pos)" units = "A", runits = "V"
jacobian (pos, flow(pos)) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
jacobian (flow(pos), pos) JacobianFlags(JACOBIAN_ENTRY_RESIST | JACOBIAN_ENTRY_RESIST_CONST | JACOBIAN_ENTRY_REACT_CONST)
0 states
has bound_step false
