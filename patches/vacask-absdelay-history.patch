 namespace NAMESPACE {
 
+static double osdiQueryPastState(void *ctx, uint32_t delayId, double time, double currentValue) {
+    if (!ctx) {
+        std::abort();
+    }
+    return static_cast<OsdiInstance*>(ctx)->queryPastState(delayId, time, currentValue);
+}
+
+static uint32_t osdiDelayCount(const OsdiDevice *device) {
+    if (device->file()->descriptorStructSize() < offsetof(OsdiDescriptor, delay) + sizeof(OsdiDelayDescriptor*)) {
+        return 0;
+    }
+    return device->descriptor()->num_delay;
+}
+
 // TODO: check unconnected terminals handling, i.e. BJT with unconnected bulk
 //       how are unconnected terminals handled
 
@@ -1128,6 +1144,68 @@ bool OsdiInstance::outputBypassCheckCore(Circuit& circuit, CommonData& commons,
     return converged;
 }
 
+void OsdiInstance::updateDelayHistory(double time) {
+    auto descr = model()->device()->descriptor();
+    auto n = osdiDelayCount(model()->device());
+    if (n == 0) {
+        return;
+    }
+    if (!delayHistoryInitialized) {
+        delayHistoryInitialized = true;
+        delayHistoryCurrentTime = time;
+        delayHistoryValues.assign(n, {});
+        return;
+    }
+    if (time == delayHistoryCurrentTime) {
+        return;
+    }
+
+    delayHistoryTimes.push_back(delayHistoryCurrentTime);
+    for (uint32_t i = 0; i < n; ++i) {
+        auto source = getDataPtr<double*>(core_, descr->delay[i].source_offset);
+        delayHistoryValues[i].push_back(*source);
+    }
+    delayHistoryCurrentTime = time;
+}
+
+double OsdiInstance::queryPastState(uint32_t delayId, double time, double currentValue) const {
+    auto descr = model()->device()->descriptor();
+    if (delayId >= osdiDelayCount(model()->device()) || delayId >= delayHistoryValues.size()) {
+        std::abort();
+    }
+    const auto& values = delayHistoryValues[delayId];
+    if (delayHistoryTimes.empty() || values.empty()) {
+        std::abort();
+    }
+    if (time < delayHistoryTimes.front()) {
+        return values.front();
+    }
+
+    auto upper = std::lower_bound(delayHistoryTimes.begin(), delayHistoryTimes.end(), time);
+    if (upper == delayHistoryTimes.begin()) {
+        return values.front();
+    }
+    if (upper == delayHistoryTimes.end()) {
+        auto lastTime = delayHistoryTimes.back();
+        auto lastValue = values.back();
+        if (time >= delayHistoryCurrentTime || delayHistoryCurrentTime <= lastTime) {
+            return lastValue;
+        }
+        auto frac = (time - lastTime) / (delayHistoryCurrentTime - lastTime);
+        return lastValue + frac * (currentValue - lastValue);
+    }
+
+    auto hi = static_cast<size_t>(upper - delayHistoryTimes.begin());
+    auto lo = hi - 1;
+    auto t0 = delayHistoryTimes[lo];
+    auto t1 = delayHistoryTimes[hi];
+    if (t1 <= t0) {
+        return values[lo];
+    }
+    auto frac = (time - t0) / (t1 - t0);
+    return values[lo] + frac * (values[hi] - values[lo]);
+}
+
 bool OsdiInstance::evalCore(Circuit& circuit, CommonData& commons, OsdiSimInfo& simInfo, EvalSetup& evalSetup) {
     // Get descriptor 
     auto model_ = model();
@@ -1155,6 +1233,9 @@ bool OsdiInstance::evalCore(Circuit& circuit, CommonData& commons, OsdiSimInfo&
     // Set beginning of state vector chunk belonging to this instance
     simInfo.prev_state = evalSetup.oldStates + offsStates;
     simInfo.next_state = evalSetup.newStates + offsStates;
+    simInfo.history_ctx = this;
+    simInfo.query_past_state = osdiQueryPastState;
+    updateDelayHistory(evalSetup.time);
 
     // Get bound step offset
     auto bsOffs = descr->bound_step_offset;
