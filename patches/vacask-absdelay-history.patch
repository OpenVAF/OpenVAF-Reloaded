+uint32_t OsdiInstance::absDelayCount() const {
+    auto device = model()->device();
+    if (!osdiHasAbsDelayInfo(device)) {
+        return 0;
+    }
+    return device->descriptor()->absdelay_count;
+}
+
+double OsdiInstance::nodeVoltage(OsdiFile::OsdiNodeIndex node, const double* solution) const {
+    if (node==UINT32_MAX) {
+        return 0.0;
+    }
+    auto u = nodes_[node]->unknownIndex();
+    return u ? solution[u] : 0.0;
+}
+
+void OsdiInstance::evaluateAbsDelay(EvalSetup& evalSetup) {
+    auto descr = model()->device()->descriptor();
+    auto count = absDelayCount();
+    if (!count || !descr->absdelay_info) {
+        return;
+    }
+
+    for(uint32_t i=0; i<count; ++i) {
+        auto& info = descr->absdelay_info[i];
+        auto& runtime = absDelay_[i];
+        auto input =
+            nodeVoltage(info.input_node_1, evalSetup.oldSolution) -
+            nodeVoltage(info.input_node_2, evalSetup.oldSolution);
+        runtime.currentOutput = nodeVoltage(info.output_node, evalSetup.oldSolution);
+
+        if (!runtime.initialized) {
+            runtime.initialized = true;
+            runtime.currentTime = evalSetup.time;
+            runtime.currentInput = input;
+        } else if (evalSetup.time != runtime.currentTime) {
+            runtime.times.push_back(runtime.currentTime);
+            runtime.values.push_back(runtime.currentInput);
+            runtime.currentTime = evalSetup.time;
+        }
+
+        runtime.currentInput = input;
+
+        double delay = 0.0;
+        if (info.delay_offset!=UINT32_MAX) {
+            delay = *getDataPtr<double*>(core(), info.delay_offset);
+        }
+        if (delay<0.0) {
+            delay = 0.0;
+        }
+
+        if (info.max_delay_offset!=UINT32_MAX) {
+            auto maxDelay = *getDataPtr<double*>(core(), info.max_delay_offset);
+            if (maxDelay>0.0 && !runtime.times.empty()) {
+                auto keepFrom = evalSetup.time - maxDelay;
+                auto firstKeep = std::lower_bound(runtime.times.begin(), runtime.times.end(), keepFrom);
+                if (firstKeep!=runtime.times.begin()) {
+                    auto eraseCount = static_cast<size_t>(firstKeep - runtime.times.begin());
+                    runtime.times.erase(runtime.times.begin(), firstKeep);
+                    runtime.values.erase(runtime.values.begin(), runtime.values.begin() + eraseCount);
+                }
+            }
+        }
+
+        auto targetTime = evalSetup.time - delay;
+        runtime.inputDerivative = 0.0;
+
+        if (delay==0.0 || targetTime>=evalSetup.time || runtime.times.empty()) {
+            runtime.delayedInput = input;
+            runtime.inputDerivative = 1.0;
+            continue;
+        }
+
+        if (targetTime<=runtime.times.front()) {
+            runtime.delayedInput = runtime.values.front();
+            continue;
+        }
+
+        auto upper = std::lower_bound(runtime.times.begin(), runtime.times.end(), targetTime);
+        if (upper==runtime.times.end()) {
+            auto last = runtime.times.size()-1;
+            auto t0 = runtime.times[last];
+            auto v0 = runtime.values[last];
+            if (evalSetup.time<=t0) {
+                runtime.delayedInput = v0;
+                continue;
+            }
+            auto fraction = (targetTime - t0) / (evalSetup.time - t0);
+            runtime.delayedInput = v0 + fraction * (input - v0);
+            runtime.inputDerivative = fraction;
+            continue;
+        }
+
+        auto hi = static_cast<size_t>(upper - runtime.times.begin());
+        if (hi==0) {
+            runtime.delayedInput = runtime.values.front();
+            continue;
+        }
+        auto lo = hi - 1;
+        auto t0 = runtime.times[lo];
+        auto t1 = runtime.times[hi];
+        if (t1<=t0) {
+            runtime.delayedInput = runtime.values[lo];
+            continue;
+        }
+        auto fraction = (targetTime - t0) / (t1 - t0);
+        runtime.delayedInput = runtime.values[lo] + fraction * (runtime.values[hi] - runtime.values[lo]);
+    }
+}
+
+void OsdiInstance::loadAbsDelay(LoadSetup& loadSetup) {
+    auto descr = model()->device()->descriptor();
+    auto count = absDelayCount();
+    if (!count || !descr->absdelay_info) {
+        return;
+    }
+
+    for(uint32_t i=0; i<count; ++i) {
+        auto& info = descr->absdelay_info[i];
+        auto& runtime = absDelay_[i];
+        auto out = nodes_[info.output_node]->unknownIndex();
+        if (!out) {
+            continue;
+        }
+
+        double residual = runtime.delayedInput - runtime.currentOutput;
+        if (loadSetup.resistiveResidual) {
+            loadSetup.resistiveResidual[out] += residual;
+        }
+        if (loadSetup.maxResistiveResidualContribution) {
+            auto contrib = std::abs(residual);
+            if (contrib > loadSetup.maxResistiveResidualContribution[out]) {
+                loadSetup.maxResistiveResidualContribution[out] = contrib;
+            }
+        }
+        if (loadSetup.loadResistiveJacobian) {
+            if (runtime.jacInput1) {
+                *runtime.jacInput1 += runtime.inputDerivative;
+            }
+            if (runtime.jacInput2) {
+                *runtime.jacInput2 -= runtime.inputDerivative;
+            }
+            if (runtime.jacOutput) {
+                *runtime.jacOutput -= 1.0;
+            }
+        }
+    }
+}
