 #include "ngspice/cktdefs.h"
 #include "osdidefs.h"
+
+#include <math.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+/* Whether the object file's descriptor reaches far enough to hold a field.
+ * Everything past the OSDI 0.4 tail is optional, so a field is only there to read
+ * when the size the file reported covers it. */
+static bool osdi_has_field(const OsdiRegistryEntry *entry, size_t off, size_t size) {
+  return (size_t)entry->descriptor_size >= off + size;
+}
+
+/* Whether to act on a request for a timepoint. See the comment at the use. */
+static bool osdi_want_breakpoints(void) {
+  const char *env = getenv("OSDI_TIMEPOINT_BREAKPOINTS");
+  return env != NULL && env[0] != '0' && env[0] != '\0';
+}
+
+/* The timepoint protocol: what the model asked of the integrator during the
+ * timepoint that has just been accepted.
+ *
+ * Both requests are numbers in the instance data, written by `eval` and read here,
+ * which is how `$bound_step` and `absdelay` already reach this simulator. See
+ * docs/osdi-timepoint-protocol.md in OpenVAF-reloaded.
+ *
+ *   breakpoint       an instant the model wants a timepoint at, which `timer`,
+ *                    `transition` and the Z-filters know exactly. CKTsetBreak puts
+ *                    a point there -- and cuts the next step as well, which is why
+ *                    this half is off unless asked for; see the comment at the use.
+ *   discontinuity    a degree announced at the point just solved. The solution is
+ *                    not continuous there, so the history behind it does not
+ *                    describe what comes next: restart at order one, which is what
+ *                    ngspice itself does on the first point after a breakpoint
+ *                    (dctran.c). The order recovers by itself from there.
+ */
+int OSDIaccept(CKTcircuit *ckt, GENmodel *in_model) {
+  OsdiRegistryEntry *entry = osdi_reg_entry_model(in_model);
+  const OsdiDescriptor *descr = entry->descriptor;
+
+  bool has_accept = osdi_has_field(entry, offsetof(OsdiDescriptor, accept),
+                                   sizeof(void (*)(void))) &&
+                    descr->accept != NULL;
+  bool has_breakpoint =
+      osdi_has_field(entry, offsetof(OsdiDescriptor, breakpoint_offset),
+                     sizeof(uint32_t)) &&
+      descr->breakpoint_offset != UINT32_MAX;
+  bool has_discontinuity =
+      osdi_has_field(entry, offsetof(OsdiDescriptor, discontinuity_offset),
+                     sizeof(uint32_t)) &&
+      descr->discontinuity_offset != UINT32_MAX;
+
+  if (getenv("OSDI_TP_TRACE")) {
+    fprintf(stderr, "[osdi] accept: size %u, offsetof(accept) %zu, accept %s\n",
+            entry->descriptor_size, offsetof(OsdiDescriptor, accept),
+            has_accept ? "yes" : "no");
+  }
+
+  if (!has_breakpoint && !has_discontinuity && !has_accept) {
+    return OK;
+  }
+
+  for (GENmodel *model = in_model; model; model = model->GENnextModel) {
+    void *model_data = osdi_model_data(model);
+    for (GENinstance *inst = model->GENinstances; inst;
+         inst = inst->GENnextInstance) {
+
+      /* The model's own accepted-point work: a `$fstrobe` line composed during
+       * the evaluations of this point is written here, from the evaluation that
+       * converged, and a point the solver went back on leaves none behind. */
+      if (has_accept) {
+        OsdiNgspiceHandle handle =
+            (OsdiNgspiceHandle){.kind = 3, .name = inst->GENname};
+        descr->accept(&handle, osdi_instance_data(entry, inst), model_data, NULL);
+      }
+
+      /* Off by default, and measured: a breakpoint in ngspice both places the
+       * point and cuts the next step to a tenth of the last one, so honouring a
+       * request costs a cluster of small steps (sim_regression/timer: 835
+       * timepoints against 509) while the model's own `$bound_step` cap already
+       * lands on the instant exactly. What a request buys here is robustness
+       * rather than cost -- an instant cannot be missed by a last-bit rounding the
+       * way a cap can -- so it is the user's call. */
+      if (has_breakpoint && osdi_want_breakpoints()) {
+        double at = *(double *)(((char *)inst) + entry->inst_offset +
+                                descr->breakpoint_offset);
+        /* Only an instant still ahead is a request: the one just solved is not
+         * one, and CKTsetBreak calls a breakpoint in the past a fatal error. */
+        if (isfinite(at) && at > ckt->CKTtime + ckt->CKTminBreak) {
+          int error = CKTsetBreak(ckt, at);
+          if (error) {
+            return error;
+          }
+        }
+      }
+
+      if (has_discontinuity) {
+        double degree = *(double *)(((char *)inst) + entry->inst_offset +
+                                    descr->discontinuity_offset);
+        if (degree >= 0.0) {
+          if (getenv("OSDI_TP_TRACE")) {
+            fprintf(stderr, "[osdi] discontinuity degree %g at t=%e (order %d)\n",
+                    degree, ckt->CKTtime, ckt->CKTorder);
+          }
+          /* Restarting the integration is only worth anything to a method that
+           * carries history across the point. Gear does; trapezoidal is a one-step
+           * method whose only past value is the derivative at the point just
+           * solved, which is the post-jump one and is what the next step wants, so
+           * cutting its order would spend an order of accuracy for nothing.
+           * Measured both ways in sim_regression/timepoints. */
+          if (ckt->CKTintegrateMethod == GEAR) {
+            ckt->CKTorder = 1;
+          }
+        }
+      }
+    }
+  }
+
+  return OK;
+}
 
